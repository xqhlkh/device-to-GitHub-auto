[Unit]
Description=GitHub 文件夹自动同步守护
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=your-username
WorkingDirectory=/opt/github-sync
ExecStart=/usr/bin/python3 /opt/github-sync/server_monitor.py -c /opt/github-sync/config.json
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=github-sync

[Install]
WantedBy=multi-user.target
